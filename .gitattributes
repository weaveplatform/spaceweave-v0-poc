# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf

# Generation and bundle golden tests compare bytes. Windows checkouts must
# preserve the LF written by the YAML bundler and Go code generator.
*.yaml text eol=lf
*.go text eol=lf
